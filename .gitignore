# Garfield++ vendor source and compiled installation
vendor/
local/

# Project build directories
projects/*/build/
projects/*/build_*/

# Simulation results and generated gas files
projects/*/results/
projects/*/*.gas
*.gas

# Generated Magboltz property sidecars
*_props.csv

# Generated ROOT files (large binary outputs)
projects/*/*.root
*.root

# parallel_plate, THGEM, double_THGEM and gas_studies have their own git repos; exclude from this workspace repo
projects/parallel_plate/
projects/THGEM/
projects/double_THGEM/
projects/gas_studies/

# LaTeX build artifacts (the .tex is the source of truth)
projects/*/docs/*.pdf
**/*.aux
**/*.synctex.gz
projects/*/docs/*.log

# Python bytecode
**/__pycache__/
**/*.pyc
**/*.pyo

# macOS metadata
.DS_Store
**/.DS_Store
